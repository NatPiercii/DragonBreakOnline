server.log*

# Builds and binaries
dist_back/
client-dist/
launcher-build/
data/
tools/
scam_native.node
node_modules/
yarn.lock
package-lock.json

# Backups and parked files
_*/
*.bak
*.bak-*
*.before-*

# Copies of the settings file, same reason
server-settings-*.json
contracts.json
pigeon-cooldowns.json
