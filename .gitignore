# The gameplay layer is tracked; secrets, binaries, runtime state and backups are not.

# Secrets and per-machine settings
server-settings.json
server-settings.*.json
.env
*.env

# Runtime state written by the server
world/
zone-spawns.json
*.tmp
notice-boards.json
officials.json
guilds.json
*.log
*.log.*
server.log*

# Builds and binaries
dist_back/
client-dist/
launcher-build/
data/
tools/
scam_native.node
node_modules/
yarn.lock
package-lock.json

# Backups and parked files
_*/
*.bak
*.bak-*
*.before-*

# Copies of the settings file, same reason
server-settings-*.json
contracts.json
pigeon-cooldowns.json

# Stray launcher stdout/stderr from a failed run-logged.cmd invocation
_launch-*.txt
server-stats.json
server-stats.json.tmp
worldclock.json
worldclock.json.tmp
supernatural.json
supernatural.json.tmp
announce.json

# Patreon identity rerolls spent (patrons.js)
patron-tokens.json

# Operator restore queue for permadead characters (supernatural.js)
revive.json

# Jail zones added in game with /jail add (jail.js)
jails.json

# Terrain heights extracted from the plugins (ck-mcp/terrain_heights.py), copied to the server by hand
terrain-heights.json

# F7 Place tab: live placements and their export (placement.js)
placements.json
placements-export.json

# commissions.js: posted work and gold held for it
commissions.json

# tenancy.js: rented property and deposits held
tenancy.json
# ledger.js: ledgers placed by staff
ledger-points.json
# gameticket.js: the in-game ticket counter
game-tickets.json
# updates.js: the version log and scheduled restarts
update-log.json
schedule.json
