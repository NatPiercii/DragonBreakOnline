  "respec": {
    "_comment": "Standing stones are the only place to change your three chosen skills. Activating a stone opens the K menu in respec mode.",
    "where": "standing stones (vanilla DoomStone activators: Warrior, Mage, Thief, Lover, Steed, Lady, Lord, Apprentice, Atronach, Ritual, Serpent, Shadow, Tower)",
    "firstRespecFree": true,
    "goldCostAfterFirst": 1200,
    "whatHappens": "drop any of the three skills and pick replacements; dropped skills lose all tier progress; no swap cooldown applies at a stone (the gold is the cost)",
    "keepsDeity": true
  },
  "worldPickup": {
    "_comment": "Nothing lying in the world can be picked up with E. Loose items placed by the plugins are not loot. Resources come from nodes (Harvesting, Mining, Woodcutter), containers, crafting and trade. Items dropped by players (dynamic ff-space refs) stay pickable so trading and dropping keep working.",
    "blockPlacedItems": true,
    "allowPlayerDropped": true,
    "nodes": [
      "FLOR",
      "TREE",
      "gold pouches (CoinPurse activators)",
      "ore veins",
      "chopping blocks",
      "books (Scholar)",
      "hanging food and herb bundles (Harvesting)"
    ],
    "farmsAndFields": "Open to everyone with the Harvesting skill. No ownership lock on crops: protecting a field is roleplay (guards, patrols, bounties), not a mechanic."
  },
  "edition": {
    "decision": "Skyrim SE 1.6.1170 with the four free base creations only. No Anniversary Edition requirement.",
    "revisit": "Alternative Armors packs (crafting variety) and player homes, launch-day decision only."
  }
