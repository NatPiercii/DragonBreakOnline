{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "src/renderer/**/*.js",
        "src/preload.js"
      ],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "globals": {
    "WebSocket": "readonly"
  }
}
