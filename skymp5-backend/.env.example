# HTTP server
# Port the Express backend listens on.
PORT=4000

# WebSocket relay
# Port for the in-game chat WebSocket relay.
WS_PORT=7778
# Shared secret between the relay and the gamemode.
RELAY_SECRET=replace-with-a-strong-random-secret

# Game server connection
# IP / hostname of the game server (for status checks and metrics proxy).
SKYMP_HOST=127.0.0.1

# IP for the public, set this to your server's public IP
SERVER_ADDRESS=

# UDP port of the game server.
SKYMP_PORT=7777

# Server metadata
# These values are returned by GET /api/serverinfo and GET /api/servers.
# Keep them in sync with the game server's own server-settings.json.
SERVER_NAME=New SkyMP Server
SERVER_MAX_PLAYERS=600
# Set to false to use online mode (session tokens via this backend).
# Must match offlineMode in the game server's server-settings.json.
SERVER_OFFLINE_MODE=false
SERVER_NPC_ENABLED=false
# Optional short label shown in the launcher (e.g. "Roleplay", "PvP").
# SERVER_GAMEMODE=Roleplay

# Master API (online mode)
# This backend acts as the master API for session validation.
# SERVER_MASTER_KEY is an arbitrary shared secret; it must match
# masterKey in the game server's server-settings.json.
# MASTER_URL is the public URL of this backend; it must match
# master in the game server's server-settings.json.
SERVER_MASTER_KEY=replace-with-a-strong-random-secret
MASTER_URL=https://api.example.com
# Shared secret between the backend and the game server for purchases, bans and
# heartbeats (sent as X-Auth-Token).
# Must match masterApiAuthToken in the game server's server-settings.json.
MASTER_API_AUTH_TOKEN=replace-with-a-strong-random-secret
# The master key is public (the launcher reads it), so a heartbeat
# (POST /api/servers/<key>) also needs X-Auth-Token or a direct loopback
# connection. true = require X-Auth-Token even from loopback; unset = also accept
# a game server on the same machine that does not send it.
# HEARTBEAT_REQUIRE_TOKEN=true

# Launch sanity check
# When true (default), the game server refuses connections from clients whose
# launcher did not verify current client files + load order right before
# launching. Set to false while players are still on launcher builds that
# predate the check.
LAUNCH_CHECK_ENFORCE=true

# Discord OAuth
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI registered in the Discord application (must match exactly).
# DISCORD_REDIRECT_URI=https://your-backend.example.com/api/users/login-discord/callback

DISCORD_BOT_TOKEN=your_bot_token_here
# Snowflake ID of the Discord server (guild) to check member roles in - not a token.
DISCORD_GUILD_ID=your_discord_server_id_here
# Channel id for the audit log: role and nickname changes, dashboard permission edits.
DISCORD_LOG_CHANNEL_ID=

# Admin dashboard (Discord OAuth)
# Standalone dashboard server. Point a subdomain at this port/service.
DASHBOARD_PORT=4002
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
# Public API base used by the dashboard browser app.
DASHBOARD_API_BASE_URL=https://api.example.com
# Separate redirect URI for the admin dashboard OAuth flow.
# Must be added to the Discord app's OAuth2 redirect list.
# DISCORD_DASHBOARD_REDIRECT_URI=https://your-backend.example.com/auth/dashboard/callback
# Comma-separated list of Discord user IDs allowed to access the admin dashboard.
DASHBOARD_DISCORD_IDS=
# Public URL of the website, used to redirect back after dashboard OAuth.
WEBSITE_URL=https://your-website.example.com
# URL of the local SkyMP-Admin service (never expose to the internet).
ADMIN_URL=http://localhost:5001
# Shared secret between the backend and the admin service (must match ADMIN_TOKEN in SkyMP-Admin/.env).
ADMIN_TOKEN=

# Website profiles ("Log in with Discord" on the website, /api/site/*)
# Redirect URI for the website sign-in; add it to the Discord app's OAuth2 redirect list.
# Defaults to WEBSITE_URL + /api/site/callback.
# DISCORD_SITE_REDIRECT_URI=https://your-website.example.com/api/site/callback
# Hours a website sign-in lasts (default 24).
# SITE_SESSION_TTL_HOURS=24
# The game server's character store: <server dir>/<databaseName>/changeForms.
# Defaults to ../build/dist/server/world/changeForms.
# CHANGEFORMS_DIR=/opt/alduinak/build/dist/server/world/changeForms
# name-table.json the game server writes into its working directory on every start
# (race and place names). Defaults to ../build/dist/server/name-table.json.
# NAME_TABLE_PATH=/opt/alduinak/build/dist/server/name-table.json
# Show the worldspace or cell name a character is in (never coordinates): on or off (default on).
# SITE_SHOW_LOCATION=on
# Folder with the game server's zones.json and officials.json (hold titles).
# Defaults to the folder NAME_TABLE_PATH is in.
# ZONES_DIR=/opt/alduinak/build/dist/server
# Show the faction and hold titles a player holds: on or off (default on).
# SITE_SHOW_FACTIONS=on

# Metrics HTTP auth
# Basic auth credentials for the game server's /metrics endpoint (port 3000).
# Must match the metricsAuth block in the game server's server-settings.json.
# Leave empty if the metrics endpoint has no auth configured.
METRICS_USER=
METRICS_PASSWORD=

# Server lockdown
# When SERVER_LOCKED=true, only Discord users with one of SERVER_LOCKED_ROLE_IDS
# or whose IDs appear in SERVER_LOCKED_ALLOW can connect.
# SERVER_LOCKED_ROLE_IDS is comma-separated and can contain multiple role IDs.
# SERVER_LOCKED_ALLOW is a legacy comma-separated list of Discord user IDs.
SERVER_LOCKED=false
SERVER_LOCKED_ROLE_IDS=
SERVER_LOCKED_ALLOW=

# Whitelist (active when SERVER_LOCKED=false)
# Managed via data/whitelist.json - edit the JSON array of Discord snowflake IDs.
# When the array is non-empty, only listed users can join.
# When the array is empty, anyone with a valid Discord session can join.
# Example contents: ["123456789012345678", "987654321098765432"]
# Set WHITELIST_ROLE_ID to use a Discord role as the gameplay whitelist instead.
# When set, this role replaces data/whitelist.json as the source of truth.
WHITELIST_ROLE_ID=
BANNED_ROLE_ID=

# GitHub webhook
# Must match the "Secret" field in the GitHub repo webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-strong-random-secret

# Branch that triggers a client pull + merge when a push is received.
# CLIENT_BRANCH=refs/heads/main

# Forum channel where the launcher's problem reports are filed, one thread per reporter
DISCORD_ERROR_FORUM_CHANNEL_ID=

# Automatic error and crash reports (docs/auto-report-v1.md)
# off: POST /api/files/report with x-report-kind: auto answers 503 and senders pause (default).
# collect: reports are checked, scrubbed and stored; nothing is posted to Discord.
# on: stored and posted to the error-report forum. Until posting is built, on stores like collect.
AUTO_REPORTS=off
# Folder for stored reports (deleted after 30 days), problem groups and limiter state
# (files are created 0600).
# Defaults to data/auto next to this file.
# AUTO_REPORT_DIR=/opt/alduinak/skymp5-backend/data/auto
# Archived source maps (client/ and front/, written by scripts/archive-symbols.js).
# Defaults to data/sourcemaps next to this file. The script always writes under
# /opt/alduinak/skymp5-backend/data, so leave this unset on the server.
# AUTO_REPORT_SOURCEMAP_DIR=/opt/alduinak/skymp5-backend/data/sourcemaps
# Seconds a sender stays quiet after the 503 while AUTO_REPORTS=off.
# AUTO_REPORT_PAUSE_SEC=3600
# true lets the launcher watch game exits and send crash reports (rollout P5).
# AUTO_REPORT_CRASH_WATCH=false
# true makes merge-files.js and populate-files.js refuse to package source maps,
# PDBs and a client bundle with an inline map (exit 1). Unset, they only warn.
# Set it once the client build uses an external map and runs archive-symbols.js.
# AUTO_REPORT_SYMBOL_GUARD=false
# Limits, with their defaults. Per visitor IP, and for requests without a live
# session all together, per 10 minutes:
# AUTO_REPORT_IP_PER_10MIN=60
# AUTO_REPORT_UNVERIFIED_PER_10MIN=120
# Per player profile: reports per 10 minutes and per UTC day, and bytes stored
# per UTC day (past it, logs and crash sections are dropped; the summary and trail are kept).
# AUTO_REPORT_PROFILE_PER_10MIN=20
# AUTO_REPORT_PROFILE_PER_DAY=100
# AUTO_REPORT_PROFILE_BYTES_PER_DAY=2097152
# New problem signatures one profile may add, per hour and per day; past that
# its reports only count toward problems already known.
# AUTO_REPORT_NEW_SIGNATURES_PER_HOUR=5
# AUTO_REPORT_NEW_SIGNATURES_PER_DAY=15
# A profile is muted for 24 hours after more than this many new signatures, or
# invalid reports (refused as malformed, or stored with fields removed), in one
# hour. A muted profile's reports get a plain 202 and are neither stored nor counted.
# AUTO_REPORT_MUTE_NEW_SIGNATURES_PER_HOUR=15
# AUTO_REPORT_MUTE_INVALID_PER_HOUR=20
